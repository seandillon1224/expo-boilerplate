# Copy to `.env` (gitignored) for local overrides. Values are pulled from EAS
# Environment Variables in CI (`eas env:pull`, wired up in T3.2).
# Only `EXPO_PUBLIC_*` keys are inlined into the JS bundle — never put secrets here.
# Validated by `src/lib/env.schema.ts`; run `bun run env:check`.

# Base URL for the demo API (http/https URL). Default: https://jsonplaceholder.typicode.com
EXPO_PUBLIC_API_URL=

# Sentry DSN. Leave empty to disable error reporting (Sentry is then a complete no-op).
# Reporting is also disabled in dev builds (__DEV__). Perf tracing is always off.
EXPO_PUBLIC_SENTRY_DSN=

# Mirrors APP_VARIANT: development | staging | uat | production. Optional.
EXPO_PUBLIC_APP_VARIANT=

# --- Build-time only (NOT inlined into the bundle; never EXPO_PUBLIC_) ---
# Sentry source-map upload for EAS Build (via the @sentry/react-native/expo config
# plugin) and EAS Update (`bun run sentry:sourcemaps`). Store SENTRY_AUTH_TOKEN with
# "sensitive" visibility in EAS environment variables / as a GitHub secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
