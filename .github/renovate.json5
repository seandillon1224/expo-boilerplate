// Renovate config. Requires the Renovate GitHub App installed AND the Mend repo setting
// `Dependency Updates (Renovate)` set to Enabled, not Silent (Silent runs jobs but opens no PRs)
// (https://github.com/apps/renovate). Bun lockfiles are supported natively.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // `:semanticCommitTypeAll(chore)` comes last so its package rule beats the
  // `:semanticPrefixFixDepsChoreOthers` rule inside config:recommended, which would give
  // production dependencies a `fix` prefix. Every Renovate PR is `chore(deps)`: a dependency bump
  // must never open or grow a release-please release PR on its own (ADR-0002; only `feat` /
  // `fix` / `perf` / `revert` and breaking changes release, docs/conventions.md).
  extends: [
    'config:recommended',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
    ':semanticCommitTypeAll(chore)',
  ],
  semanticCommitType: 'chore',
  timezone: 'America/New_York',
  schedule: ['before 6am on monday'],
  labels: ['dependencies'],
  rangeStrategy: 'bump',
  // Never bump onto a release that is less than three days old: unpublished / yanked / hotfixed
  // releases are caught before a PR exists. `internalChecksFilter: 'strict'` makes Renovate hold
  // the whole update back while that window is open instead of falling through to an older
  // version (the digest group below opts out — digests are re-tags of an existing release).
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  // Auto-merge goes through GitHub's native auto-merge, gated by the required checks that
  // `bun run repo:settings:apply` (scripts/repo-settings.js) configures on `main`.
  automergeType: 'pr',
  platformAutomerge: true,
  lockFileMaintenance: { enabled: true, schedule: ['before 6am on the first day of the month'] },
  packageRules: [
    // Dev tooling patch/minor: auto-merge once the JS gate is green. Every rule below this one
    // is a carve-out from it — later rules win, so the narrower groups have to come after.
    {
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'dev tooling (minor/patch)',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    // Expo SDK packages move together and must be bumped with `bunx expo install --fix`
    // on an SDK upgrade, not one at a time. Group them and never auto-merge; majors are
    // handled by the expo-upgrade flow (D1/D5 will decide the cadence). The list matches the
    // major rule below, so an SDK package is never split between the two — several of these
    // (`jest-expo`, `eslint-config-expo`, some `@expo/**`) are devDependencies and would
    // otherwise be pulled back into the auto-merging dev-tooling group above.
    {
      groupName: 'expo sdk',
      matchPackageNames: [
        'expo',
        'react-native',
        'react',
        'react-dom',
        'react-test-renderer',
        'expo-**',
        '@expo/**',
        'react-native-**',
        '@react-native/**',
        'eslint-config-expo',
        'jest-expo',
      ],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: false,
    },
    {
      matchPackageNames: [
        'expo',
        'react-native',
        'react',
        'react-dom',
        'react-test-renderer',
        'expo-**',
        '@expo/**',
        'react-native-**',
        '@react-native/**',
        'eslint-config-expo',
        'jest-expo',
      ],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // ESLint stays on 9. `eslint-config-expo` pulls in `eslint-plugin-react` (peer `<=^9.7`) and
    // `eslint-plugin-import` (peer `<=^9`); neither accepts ESLint 10, and both are transitive
    // deps of that config, so they cannot be bumped out of the way — the rule above disables
    // `eslint-config-expo` majors, which is what would carry the fix. Without this rule Renovate
    // reopens the same doomed v10 PR every week.
    // Revisit when `eslint-config-expo` ships `eslint-plugin-react` >= 7.38 / `eslint-plugin-import`
    // >= 2.33 with an `^10` peer: check with
    //   bun pm ls --all | grep -E 'eslint-plugin-(react|import)@'
    // then flip this to `enabled: true` and let the v10 PR run the gate.
    {
      matchPackageNames: ['eslint'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // oxlint and its ESLint bridge (ADR-0004): the plugin's rule list must match the oxlint
    // binary, so they bump in lockstep. Later rules win, so this comes after the generic
    // dev-tooling group to pull both packages out of it. Minor/patch only: an oxlint major
    // changes the default rule set and must be read before it lands.
    {
      groupName: 'oxlint',
      matchPackageNames: ['oxlint', 'eslint-plugin-oxlint'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    // VitePress and its mermaid plugin (docs site, T8.4): the plugin pins the mermaid major it
    // renders with and tracks VitePress releases, so the three bump together. Same placement
    // reason as the oxlint group: later rules win. Minor/patch only — a VitePress or mermaid
    // major is a docs-site migration, not an auto-merge.
    {
      groupName: 'vitepress',
      matchPackageNames: ['vitepress', 'vitepress-plugin-mermaid', 'mermaid'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    // eas-cli: the `cli.version` floor in `eas.json` (`>= 23.0.0`) does not cap the major, so a
    // major bump here would otherwise ride in on the dev-tooling group and silently move every
    // EAS build / update / workflow onto a new CLI. Minor/patch auto-merge, major by hand.
    {
      groupName: 'eas-cli',
      matchPackageNames: ['eas-cli'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      matchPackageNames: ['eas-cli'],
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    // GitHub Actions: pin to digests, auto-merge minor/patch.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github actions',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    // Digest re-tags point at a release that already cleared `minimumReleaseAge`, so the
    // three-day hold would only delay a security re-pin. Group membership is inherited from
    // the rule above; this one only lifts the wait.
    {
      matchUpdateTypes: ['digest'],
      minimumReleaseAge: '0 days',
    },
  ],
  // Versions pinned in files Renovate has no manager for. Each `matchStrings` entry is matched
  // against every file in `managerFilePatterns`, so one regex may cover several occurrences.
  customManagers: [
    {
      // Maestro CLI: `maestro_version:` in the EAS workflow files, `MAESTRO_VERSION:` in the JS
      // gate, and `maestroPinned` in the doctor's EXPECTED table. All three must move together.
      // Maestro tags releases as `cli-<version>`.
      customType: 'regex',
      description: 'Maestro CLI version pinned in CI and scripts/doctor.js',
      managerFilePatterns: [
        '/^\\.eas/workflows/.*\\.ya?ml$/',
        '/^\\.github/workflows/ci\\.yml$/',
        '/^scripts/doctor\\.js$/',
      ],
      matchStrings: [
        '(?:maestro_version|MAESTRO_VERSION):\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)',
        'maestroPinned:\\s*[\'"](?<currentValue>\\d+\\.\\d+\\.\\d+)[\'"]',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'mobile-dev-inc/Maestro',
      extractVersionTemplate: '^cli-(?<version>.*)$',
    },
    {
      // Bun on EAS Build (`build.base.bun` in eas.json). Bun tags releases as `bun-v<version>`.
      customType: 'regex',
      description: 'Bun version used by EAS Build',
      managerFilePatterns: ['/^eas\\.json$/'],
      matchStrings: ['"bun":\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'oven-sh/bun',
      extractVersionTemplate: '^bun-v(?<version>.*)$',
    },
  ],
}
