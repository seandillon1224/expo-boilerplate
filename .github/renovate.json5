// Renovate config. Requires the Renovate GitHub App to be installed on the repo
// (https://github.com/apps/renovate). Bun lockfiles are supported natively.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // `:semanticCommitTypeAll(chore)` comes last so its package rule beats the
  // `:semanticPrefixFixDepsChoreOthers` rule inside config:recommended, which would give
  // production dependencies a `fix` prefix. Every Renovate PR is `chore(deps)`: a dependency bump
  // must never open or grow a release-please release PR on its own (ADR-0002; only `feat` /
  // `fix` / `perf` / `revert` and breaking changes release, docs/conventions.md).
  extends: [
    'config:recommended',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
    ':semanticCommitTypeAll(chore)',
  ],
  semanticCommitType: 'chore',
  timezone: 'America/New_York',
  schedule: ['before 6am on monday'],
  labels: ['dependencies'],
  rangeStrategy: 'bump',
  // Auto-merge goes through GitHub's native auto-merge, gated by the required checks that
  // `bun run repo:settings:apply` (scripts/repo-settings.js) configures on `main`.
  automergeType: 'pr',
  platformAutomerge: true,
  lockFileMaintenance: { enabled: true, schedule: ['before 6am on the first day of the month'] },
  packageRules: [
    // Expo SDK packages move together and must be bumped with `bunx expo install --fix`
    // on an SDK upgrade, not one at a time. Group them and never auto-merge; majors are
    // handled by the expo-upgrade flow (D1/D5 will decide the cadence).
    {
      groupName: 'expo sdk',
      matchPackageNames: [
        'expo',
        'react-native',
        'react',
        'react-dom',
        'react-test-renderer',
        'jest-expo',
      ],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: false,
    },
    {
      matchPackageNames: [
        'expo',
        'react-native',
        'react',
        'react-dom',
        'expo-**',
        '@expo/**',
        'react-native-**',
        '@react-native/**',
      ],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // Dev tooling patch/minor: auto-merge once the JS gate is green.
    {
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'dev tooling (minor/patch)',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    // oxlint and its ESLint bridge (ADR-0004): the plugin's rule list must match the oxlint
    // binary, so they bump in lockstep. Later rules win, so this comes after the generic
    // dev-tooling group to pull both packages out of it.
    {
      groupName: 'oxlint',
      matchPackageNames: ['oxlint', 'eslint-plugin-oxlint'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    // GitHub Actions: pin to digests, auto-merge minor/patch.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github actions',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
  ],
}
