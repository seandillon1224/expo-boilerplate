# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo (`.expo/` also holds the `bun run atlas:export` output, .expo/atlas.jsonl)
.expo/
dist/
dist-*/
# `eas deploy --dry-run` tarball
deploy.tar.gz
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env (pulled from EAS; never committed)
.env
.env.*
!.env.example

# test / e2e output
coverage/
junit/
.maestro/**/*.mp4
.maestro/**/*.png
maestro-web/
maestro-ios/
maestro-android/
# native E2E base/repacked builds pulled by `bun run e2e:build` / `e2e:repack`
e2e/builds/
.reassure/
# `bun run perf:flashlight` results + HTML report (default --out)
flashlight/

# VitePress (bun run docs:*)
docs/.vitepress/cache/
docs/.vitepress/dist/
