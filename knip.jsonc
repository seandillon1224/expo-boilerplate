{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // knip's built-in Expo plugin already understands app.config.ts, expo-router
  // file routes, and the SDK's implicit peer dependencies. Only extras go here.
  "entry": [
    "src/**/*.{ios,android,web,native}.{ts,tsx}",
    "scripts/**/*.{js,ts}",
    // Reassure perf tests: run by `bun run perf` (Reassure's own Jest invocation), not jest.config.js.
    "src/__perf__/**/*.perf-test.tsx",
    // Styling primitives are a public surface for future screens; do not report unused exports.
    "src/tw/index.tsx",
    // Reached only through the `__DEV__` require in src/lib/devtools.ts (kept out of prod bundles).
    "src/lib/devtools-plugins.ts",
    // Loaded by @expo/fingerprint itself (every fingerprint path), not imported by our code.
    "fingerprint.config.js",
    // Loaded by `vitepress build docs` (bun run docs:*), which is how vitepress / mermaid are used.
    "docs/.vitepress/config.mts",
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,ts}", "*.{js,ts}"],
  // Maestro CLI is installed outside package.json (~/.maestro/bin locally, curl installer in CI).
  "ignoreBinaries": ["maestro"],
  "ignoreDependencies": [
    // Only referenced in jest.config.js when CI is set; knip evaluates it without CI.
    "jest-junit",
  ],
}
