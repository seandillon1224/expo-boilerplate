{
  "name": "expo-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "clsx": "^2.1.1",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-observe": "~57.0.18",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "i18next": "^26.4.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@expo/fingerprint": "0.20.12",
    "@expo/repack-app": "0.10.3",
    "@rozenite/metro": "2.4.0",
    "@rozenite/network-activity-plugin": "2.4.0",
    "@rozenite/performance-monitor-plugin": "2.4.0",
    "@rozenite/tanstack-query-plugin": "2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29",
    "@types/react": "~19.2.2",
    "eas-cli": "^23",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expo-atlas": "^0.4.3",
    "i18next-parser": "^9.4.0",
    "jest": "~29.7",
    "jest-expo": "~57",
    "jest-junit": "^17.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "oxlint": "1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-native-performance": "6.0.0",
    "reassure": "^1.6.0",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall-guard.js",
    "init": "node scripts/init.js",
    "doctor": "node scripts/doctor.js",
    "template:e2e": "node scripts/template-e2e.js",
    "start": "WITH_ROZENITE=${WITH_ROZENITE:-true} expo start",
    "ios": "WITH_ROZENITE=${WITH_ROZENITE:-true} expo start --ios",
    "android": "WITH_ROZENITE=${WITH_ROZENITE:-true} expo start --android",
    "env:check": "bun scripts/env-check.ts",
    "env:pull": "eas env:pull --environment ${EAS_ENV:-development} --path .env.local --non-interactive",
    "env:pull:preview": "EAS_ENV=preview bun run env:pull",
    "env:pull:production": "EAS_ENV=production bun run env:pull",
    "fingerprint": "node scripts/fingerprint.js",
    "devices:add": "node scripts/devices-add.js",
    "devices:list": "eas device:list",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "budget": "bun run budget:web && bun run budget:ios && bun run budget:android",
    "budget:web": "bun scripts/bundle-budget.js --platform web",
    "budget:ios": "bun scripts/bundle-budget.js --platform ios",
    "budget:android": "bun scripts/bundle-budget.js --platform android",
    "atlas": "EXPO_ATLAS=true bun run start",
    "atlas:export": "EXPO_ATLAS=true expo export --platform ${ATLAS_PLATFORM:-all} --output-dir dist-atlas && bun run atlas:serve",
    "atlas:export:web": "ATLAS_PLATFORM=web bun run atlas:export",
    "atlas:export:ios": "ATLAS_PLATFORM=ios bun run atlas:export",
    "atlas:export:android": "ATLAS_PLATFORM=android bun run atlas:export",
    "atlas:serve": "expo-atlas .expo/atlas.jsonl",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.js",
    "i18n:extract": "i18next",
    "i18n:check": "i18next --fail-on-update --fail-on-warnings",
    "web": "expo start --web",
    "serve:web": "bun scripts/serve-web.js",
    "e2e:build": "node scripts/e2e-build.js",
    "e2e:repack": "node scripts/e2e-repack.js",
    "e2e:ios": "node scripts/e2e-run.js --platform ios",
    "e2e:android": "node scripts/e2e-run.js --platform android",
    "e2e:web": "maestro test .maestro -e APP_URL=${APP_URL:-http://localhost:8081} --include-tags web --exclude-tags quarantine --headless --screen-size 1280x800 --format junit --output maestro-web/report.xml --test-output-dir maestro-web --debug-output maestro-web/debug --flatten-debug-output",
    "lint": "oxlint && expo lint",
    "typecheck": "node scripts/ensure-expo-env.js && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "perf": "reassure",
    "perf:baseline": "reassure --baseline",
    "perf:check": "reassure check-stability",
    "perf:gate": "node scripts/reassure-gate.js",
    "observe:check": "node scripts/observe-check.js",
    "prepare": "lefthook install",
    "repo:settings": "node scripts/repo-settings.js --dry-run",
    "repo:settings:apply": "node scripts/repo-settings.js --apply",
    "repo:settings:check": "node scripts/repo-settings.js --check",
    "secrets:scan": "node scripts/secrets-scan.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "private": true,
  "license": "MIT",
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
